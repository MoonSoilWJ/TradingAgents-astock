{
  "jobs": [
    {
      "id": "t0_sell_watch",
      "name": "T+0 卖出检查",
      "cron": "40 09 * * 1-5",
      "script": "scripts/t0_sell_watch.py",
      "strategy_id": "t0_baseline_trix"
    },
    {
      "id": "t0_quality_pool",
      "name": "T+0 优质池滚动刷新",
      "cron": "20 09 * * 1-5",
      "script": "scripts/quality_pool.py --lookback 30",
      "strategy_id": "t0_baseline_trix",
      "log": "quality_pool.log"
    },
    {
      "id": "t0_signal",
      "name": "T+0 买入信号",
      "cron": "45 14 * * 1-5",
      "script": "scripts/t0_monitor.py --signal",
      "strategy_id": "t0_baseline_trix"
    },
    {
      "id": "min_cache",
      "name": "分钟 K 缓存",
      "cron": "10 15 * * 1-5",
      "script": "scripts/cache_min_data.py",
      "strategy_id": "min_cache",
      "log": "min_cache.log"
    },
    {
      "id": "min_cache_allmarket",
      "name": "全市场分钟 K 缓存",
      "cron": "35 15 * * 1-5",
      "script": "scripts/cache_min_data.py --all-market --workers 8",
      "strategy_id": "min_cache",
      "log": "min_cache_allmarket.log"
    },
    {
      "id": "t0_walk_forward",
      "name": "T+0 Walk-Forward 复核",
      "cron": "0 09 1-7 * 1",
      "script": "scripts/t0_walk_forward.py",
      "strategy_id": "t0_wf_time",
      "log": "walk_forward.log"
    },
    {
      "id": "bidle_signal",
      "name": "B+idle 核心信号",
      "cron": "45 14 * * 1-5",
      "script": "scripts/t0_b_idle_shadow.py --signal",
      "strategy_id": "t0_b_idle_shadow",
      "log": "b_idle_shadow.log"
    },
    {
      "id": "bidle_idle_buy",
      "name": "B+idle idle动量腿买入",
      "cron": "50 14 * * 1-5",
      "script": "scripts/t0_b_idle_shadow.py --idle-buy",
      "strategy_id": "t0_b_idle_shadow",
      "log": "b_idle_shadow.log"
    },
    {
      "id": "bidle_sell_watch",
      "name": "B+idle 核心 hybrid 卖出监控",
      "cron": "40 09 * * 1-5",
      "script": "scripts/t0_b_idle_shadow.py --sell-loop",
      "strategy_id": "t0_b_idle_shadow",
      "log": "b_idle_shadow.log"
    },
    {
      "id": "bidle_idle_sell",
      "name": "B+idle idle次日固定卖",
      "cron": "49 14 * * 1-5",
      "script": "scripts/t0_b_idle_shadow.py --sell-check --idle-sell",
      "strategy_id": "t0_b_idle_shadow",
      "log": "b_idle_shadow.log"
    }
  ]
}
